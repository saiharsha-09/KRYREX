<script>
document.getElementById('year').textContent=new Date().getFullYear();

const reduceMotion=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const coarse=window.matchMedia('(pointer: coarse)').matches;
let energy=true,mouseX=0,mouseY=0,scrollP=0;
const uni=document.getElementById('universe'),u=uni.getContext('2d');
const core=document.getElementById('core'),c=core.getContext('2d');
let W=innerWidth,H=innerHeight,D=Math.min(devicePixelRatio||1,2),stars=[],sparks=[],ribbons=[];
const rand=(a,b)=>a+Math.random()*(b-a);
function resize(){
 W=innerWidth;H=innerHeight;D=Math.min(devicePixelRatio||1,2);
 uni.width=W*D;uni.height=H*D;u.setTransform(D,0,0,D,0,0);
 let rect=core.getBoundingClientRect();
 core.width=Math.max(1,Math.round(rect.width*D));core.height=Math.max(1,Math.round(rect.height*D));
 c.setTransform(D,0,0,D,0,0);
 stars=Array.from({length:Math.min(430,Math.round(W*H/2600))},()=>({x:rand(0,W),y:rand(0,H),r:rand(.3,1.7),a:rand(.15,.8),p:rand(0,7)}));
 sparks=Array.from({length:Math.min(180,Math.round(W/5))},()=>({a:rand(0,Math.PI*2),r:rand(45,240),speed:rand(.002,.012),size:rand(.4,2),life:rand(0,1),trail:rand(5,35)}));
 ribbons=Array.from({length:9},()=>({a:rand(0,7),speed:rand(.002,.009),r:rand(.24,.47),w:rand(.5,1.8),phase:rand(0,7)}));
}
window.addEventListener('resize',resize);
if(!coarse)window.addEventListener('pointermove',e=>{mouseX=(e.clientX/W-.5);mouseY=(e.clientY/H-.5)},{passive:true});
window.addEventListener('scroll',()=>{scrollP=scrollY/Math.max(1,document.body.scrollHeight-H)},{passive:true});

let last=0,t=0;
function draw(now){
 requestAnimationFrame(draw);
 if(!energy)return;
 if(now-last<30)return;
 last=now;t=reduceMotion?1:now*.001;
 u.clearRect(0,0,W,H);
 let bg=u.createRadialGradient(W*.5,H*.43,0,W*.5,H*.43,Math.max(W,H)*.75);
 bg.addColorStop(0,'rgba(85,52,19,.105)');bg.addColorStop(.5,'rgba(32,23,16,.045)');bg.addColorStop(1,'rgba(0,0,0,0)');
 u.fillStyle=bg;u.fillRect(0,0,W,H);

 for(const s of stars){
  let tw=.5+.5*Math.sin(t*1.4+s.p);
  u.globalAlpha=s.a*tw;
  u.fillStyle=s.r>1.35?'#ffeac0':'#d5c7a7';
  u.beginPath();u.arc(s.x,s.y,s.r,0,Math.PI*2);u.fill();
  if(s.r>1.5&&tw>.9){u.globalAlpha=.13;u.fillRect(s.x-5,s.y,.01+10,.5);u.fillRect(s.x,s.y-5,.5,10)}
 }
 u.globalAlpha=1;

 // Distant galactic spiral arms
 u.save();u.translate(W*.5+mouseX*22,H*.48+mouseY*14);
 for(let arm=0;arm<4;arm++){
  u.beginPath();
  for(let i=0;i<210;i++){
   let f=i/209,ang=f*7.8+t*.05+arm*Math.PI/2;
   let r=f*Math.min(W,H)*.46;
   let x=Math.cos(ang)*r,y=Math.sin(ang)*r*.54;
   if(i===0)u.moveTo(x,y);else u.lineTo(x,y);
  }
  u.strokeStyle=arm%2?'rgba(197,151,76,.035)':'rgba(255,223,159,.05)';
  u.lineWidth=1;u.stroke();
 }
 u.restore();

 // Floating sparks and elongated trails
 for(const p of sparks){
  p.a+=p.speed*(reduceMotion?.1:1);
  p.life+=.002;
  if(p.life>1){p.life=0;p.r=rand(45,Math.min(W,H)*.43)}
  let cx=W*.5+mouseX*30,cy=H*.46+mouseY*22;
  let ang=p.a;
  let x=cx+Math.cos(ang)*p.r;
  let y=cy+Math.sin(ang)*p.r*.62;
  let dx=-Math.sin(ang)*p.trail,dy=Math.cos(ang)*p.trail*.62;
  let gr=u.createLinearGradient(x-dx,y-dy,x,y);
  gr.addColorStop(0,'rgba(230,177,83,0)');
  gr.addColorStop(1,`rgba(255,224,153,${.15+.7*Math.abs(Math.sin(p.a*2))})`);
  u.strokeStyle=gr;u.lineWidth=p.size;u.beginPath();u.moveTo(x-dx,y-dy);u.lineTo(x,y);u.stroke();
  u.fillStyle='#fff0c8';u.globalAlpha=.3+.7*Math.abs(Math.sin(p.a*2.7));
  u.beginPath();u.arc(x,y,p.size*.8,0,Math.PI*2);u.fill();
 }
 u.globalAlpha=1;

 // Main luminous orbital core
 const cw=core.width/D,ch=core.height/D,cx=cw/2,cy=ch/2,R=Math.min(cw,ch)*.29;
 c.clearRect(0,0,cw,ch);
 c.save();c.translate(cx,cy);
 const glow=c.createRadialGradient(0,0,0,0,0,R*2.2);
 glow.addColorStop(0,'rgba(255,233,179,.21)');
 glow.addColorStop(.25,'rgba(235,171,65,.15)');
 glow.addColorStop(.65,'rgba(176,102,28,.055)');
 glow.addColorStop(1,'rgba(0,0,0,0)');
 c.fillStyle=glow;c.beginPath();c.arc(0,0,R*2.2,0,Math.PI*2);c.fill();

 // Spinning ellipses, with variable inclinations
 for(let i=0;i<7;i++){
  let angle=t*(.17+i*.035)+i*1.04;
  c.save();c.rotate(angle);
  c.beginPath();c.ellipse(0,0,R*(1.05+(i%3)*.17),R*(.23+(i%4)*.055),i*.24,0,Math.PI*2);
  c.strokeStyle=i%2?'rgba(227,184,99,.48)':'rgba(255,246,213,.3)';
  c.lineWidth=i===2?1.7:.8;c.stroke();
  for(let j=0;j<3;j++){
   let a=t*(.8+j*.16)+i*2+j*2.09;
   let x=Math.cos(a)*R*(1.05+(i%3)*.17),y=Math.sin(a)*R*(.23+(i%4)*.055);
   c.fillStyle=j===0?'#fff7db':'#e6b65f';
   c.shadowColor='#ffc85f';c.shadowBlur=12;
   c.beginPath();c.arc(x,y,j===0?2.2:1.2,0,Math.PI*2);c.fill();c.shadowBlur=0;
  }
  c.restore();
 }
 // Golden plasma shell
 let sphere=c.createRadialGradient(-R*.3,-R*.38,R*.04,0,0,R);
 sphere.addColorStop(0,'#fffce9');
 sphere.addColorStop(.12,'#f5dfa1');
 sphere.addColorStop(.3,'#dca54a');
 sphere.addColorStop(.52,'#80501e');
 sphere.addColorStop(.7,'#24180f');
 sphere.addColorStop(.82,'#c28c39');
 sphere.addColorStop(.88,'#fff0b8');
 sphere.addColorStop(1,'rgba(255,197,89,.02)');
 c.fillStyle=sphere;c.beginPath();c.arc(0,0,R,0,Math.PI*2);c.fill();

 // Spiralling filaments inside the core
 c.save();c.beginPath();c.arc(0,0,R*.96,0,Math.PI*2);c.clip();
 for(let arm=0;arm<5;arm++){
  c.beginPath();
  for(let i=0;i<360;i++){
   let f=i/359,ang=f*9+t*(arm%2?.45:-.3)+arm*Math.PI*2/5;
   let rr=R*(.04+f*.9);
   let x=Math.cos(ang)*rr,y=Math.sin(ang)*rr;
   if(!i)c.moveTo(x,y);else c.lineTo(x,y);
  }
  c.strokeStyle=arm%2?'rgba(255,242,192,.68)':'rgba(255,179,65,.72)';
  c.lineWidth=1.2;c.stroke();
 }
 for(let i=0;i<90;i++){
  let a=i*2.4+t*.2,rr=R*rand(.2,.92);
  c.fillStyle=i%3?'rgba(255,225,158,.6)':'rgba(255,255,240,.9)';
  c.beginPath();c.arc(Math.cos(a)*rr,Math.sin(a)*rr,rand(.3,1.2),0,Math.PI*2);c.fill();
 }
 c.restore();

 // White-gold nucleus
 const nucleus=c.createRadialGradient(-R*.05,-R*.06,0,0,0,R*.31);
 nucleus.addColorStop(0,'#ffffff');nucleus.addColorStop(.2,'#fff5cf');nucleus.addColorStop(.55,'#f1c36d');nucleus.addColorStop(1,'rgba(255,194,82,0)');
 c.fillStyle=nucleus;c.beginPath();c.arc(0,0,R*.4,0,Math.PI*2);c.fill();

 // Erupting rays
 for(let i=0;i<60;i++){
  let a=i*2.399+t*(i%2?.3:-.24),inner=R*(.95+(i%7)*.02),outer=inner+R*(.05+(i%9)*.075);
  c.strokeStyle=i%5===0?'rgba(255,249,216,.9)':'rgba(244,185,86,.33)';
  c.lineWidth=i%7===0?1.2:.45;
  c.beginPath();c.moveTo(Math.cos(a)*inner,Math.sin(a)*inner);c.lineTo(Math.cos(a)*outer,Math.sin(a)*outer);c.stroke();
 }
 c.restore();

 if(!reduceMotion){
  const el=document.getElementById('coreWrap');
  el.style.transform=`translate3d(${mouseX*7}px,${mouseY*6}px,0)`;
 }
}
resize();requestAnimationFrame(draw);

function toggleEnergy(){
 energy=!energy;
 document.getElementById('energyBtn').textContent=energy?'ENERGY: ACTIVE ◉':'ENERGY: PAUSED ○';
 if(energy)requestAnimationFrame(draw);
 else{u.clearRect(0,0,W,H);c.clearRect(0,0,core.width,core.height)}
}


function renderChecklist(plan) {
  const result = document.getElementById('plannerResult');
  result.replaceChildren();

  const wrap = document.createElement('div');
  wrap.className = 'plan-checklist';

  const progress = document.createElement('div');
  progress.className = 'plan-progress';
  progress.innerHTML = '<div class="plan-progress-top"><span>YOUR PROGRESS</span><strong id="planProgressText">0 / 0 completed</strong></div><div class="plan-progress-track"><div id="planProgressFill"></div></div>';
  wrap.appendChild(progress);

  const list = document.createElement('div');
  list.className = 'plan-task-list';
  let total = 0;

  function updateProgress() {
    const boxes = list.querySelectorAll('input[type="checkbox"]');
    const done = list.querySelectorAll('input[type="checkbox"]:checked').length;
    progress.querySelector('#planProgressText').textContent = done + ' / ' + boxes.length + ' completed';
    progress.querySelector('#planProgressFill').style.width =
      (boxes.length ? done / boxes.length * 100 : 0) + '%';
  }

  String(plan).split(/\r?\n/).forEach(line => {
    const text = line.trim().replace(/^[-*•]\s+/, '').replace(/\*\*/g, '');
    if (!text) return;

    const isHeading =
      /^#{1,6}\s/.test(line.trim()) ||
      /^(?:\d+\.\s*)?(STUDY GOAL|DAILY TIMETABLE|TOPIC BREAKDOWN|WHY THIS PLAN WORKS|NEXT STEPS|PROGRESS CHECK)\b/i.test(text);

    if (isHeading) {
      const title = document.createElement('h3');
      title.className = 'plan-section-title';
      title.textContent = text.replace(/^#{1,6}\s*/, '');
      wrap.appendChild(title);
      return;
    }

    const label = document.createElement('label');
    label.className = 'plan-task';
    const box = document.createElement('input');
    box.type = 'checkbox';
    box.id = 'kryrex-task-' + (++total);
    box.addEventListener('change', updateProgress);

    const span = document.createElement('span');
    span.textContent = text;

    label.htmlFor = box.id;
    label.append(box, span);
    list.appendChild(label);
  });

  wrap.appendChild(list);
  result.appendChild(wrap);
  updateProgress();
}

document.getElementById('plannerForm').addEventListener('submit', async function(e) {
e.preventDefault();
const form = new FormData(this);
const button = document.getElementById('planSubmit');
const status = document.getElementById('plannerStatus');
const result = document.getElementById('plannerResult');
button.disabled = true;
button.textContent = 'GENERATING...';
status.textContent = 'KRYREX AI is thinking...';
result.classList.remove('show');
try {
const response = await fetch('/api/plan', {
method: 'POST',
headers: {'Content-Type': 'application/json'},
body: JSON.stringify({subject:form.get('subject'),hours:form.get('hours'),level:form.get('level'),goal:form.get('goal')})
});
const data = await response.json();
if (!response.ok || !data.success) throw new Error(data.error || 'Request failed');
renderChecklist(data.plan);
result.classList.add('show');
status.textContent = 'YOUR PLAN IS READY';
} catch (err) {
status.textContent = err.message;
} finally {
button.disabled = false;
button.textContent = 'GENERATE MY AI STUDY PLAN ↗';
}
});

</script>
