<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--gold:#e9c878;--white:#fff8e9;--black:#030303}
html{scroll-behavior:smooth}
body{background:var(--black);color:white;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;overflow-x:hidden}
body:after{content:"";position:fixed;inset:0;pointer-events:none;z-index:5;opacity:.12;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.16'/%3E%3C/svg%3E")}
#universe{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
nav{position:absolute;top:0;width:100%;padding:27px 7%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ffffff12;z-index:10}
.logo{font-size:22px;font-weight:800;letter-spacing:6px;color:var(--gold)}
.navlinks{display:flex;align-items:center;gap:32px}
.navlinks a{color:#aaa;text-decoration:none;font-size:11px;letter-spacing:2px}
.navlinks a:hover{color:var(--gold)}
.pill{padding:12px 18px;border:1px solid #e9c87870;background:#e9c87809;color:var(--gold);font-size:10px;letter-spacing:2px;cursor:pointer;transition:.3s}
.pill:hover{background:var(--gold);color:#000;box-shadow:0 0 30px #e9c87850}
.hero{position:relative;z-index:1;min-height:100svh;display:flex;flex-direction:column;align-items:center;text-align:center;padding:120px 20px 55px;overflow:hidden}
.kicker{font-size:10px;letter-spacing:6px;color:var(--gold);margin-top:20px;animation:fade .9s both}
.core-wrap{position:relative;width:min(77vw,570px);height:min(77vw,570px);max-height:570px;display:grid;place-items:center;margin:0 auto -4px;perspective:1000px;isolation:isolate}
.core-wrap:before{content:"";position:absolute;width:80%;height:80%;border-radius:50%;background:radial-gradient(circle,#e9b64a15 0%,#b57b2420 25%,#6d3c170a 52%,transparent 70%);filter:blur(24px);animation:breath 4s ease-in-out infinite}
.core-wrap:after{content:"";position:absolute;width:52%;height:52%;border-radius:50%;background:radial-gradient(circle,#fff9df16,transparent 68%);filter:blur(18px)}
#core{width:100%;height:100%;position:relative;z-index:1;overflow:visible;filter:drop-shadow(0 0 28px #d89b3440)}
.core-label{position:absolute;bottom:8%;left:50%;transform:translateX(-50%);white-space:nowrap;color:#d8c59d;font-size:9px;letter-spacing:4px;z-index:3}
h1{font-size:clamp(45px,8vw,96px);line-height:1.02;font-weight:500;letter-spacing:-4px;margin-top:-5px;animation:fade 1.1s .15s both}
h1 span{background:linear-gradient(110deg,#fff8d9 5%,#e6c06a 38%,#a77a2f 65%,#fff0b6 88%);background-clip:text;-webkit-background-clip:text;color:transparent}
.sub{font-size:13px;line-height:2;color:#96918a;max-width:460px;margin:24px auto 28px;animation:fade 1.2s .3s both}
.actions{display:flex;justify-content:center;gap:13px;flex-wrap:wrap}
.btn{padding:16px 23px;border:1px solid #e9c87880;color:var(--gold);background:#e9c8780b;font-size:10px;letter-spacing:2px;cursor:pointer;transition:.3s}
.btn.primary{background:linear-gradient(110deg,#f0d58d,#c19a4d);color:#100c05;border:0;font-weight:700}
.btn:hover{transform:translateY(-3px);box-shadow:0 0 32px #e9c87832}
.meta{margin-top:39px;font-size:9px;letter-spacing:3px;color:#777}
.dot{display:inline-block;width:5px;height:5px;border-radius:50%;background:#e9c878;box-shadow:0 0 10px #e9c878;margin-right:9px}
.section{position:relative;z-index:1;padding:110px 8%;border-top:1px solid #ffffff12;background:linear-gradient(180deg,#030303bd,#030303f5)}
.heading{text-align:center;margin-bottom:55px}
.heading small{color:var(--gold);letter-spacing:5px;font-size:10px}
.heading h2{font-size:clamp(30px,4vw,52px);font-weight:400;margin:20px 0}
.heading p{font-size:13px;color:#888}
.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;max-width:1150px;margin:auto}
.card{padding:35px 28px;min-height:220px;background:linear-gradient(140deg,#ffffff0b,#ffffff02);border:1px solid #ffffff16;transition:.35s}
.card:hover{transform:translateY(-6px);border-color:#e9c87880;background:#e9c87809}
.num{font-size:10px;letter-spacing:3px;color:var(--gold)}
.card h3{font-size:21px;font-weight:400;margin:28px 0 15px}
.card p{font-size:13px;line-height:1.9;color:#929292}
.final{text-align:center;position:relative;z-index:1;padding:125px 20px}
.final h2{font-size:clamp(36px,6vw,70px);font-weight:400;letter-spacing:-2px}
.final h2 span{color:var(--gold)}
.final p{margin:20px 0 30px;color:#999;font-size:13px}
footer{position:relative;z-index:1;display:flex;justify-content:space-between;align-items:center;gap:18px;flex-wrap:wrap;padding:25px 7%;border-top:1px solid #ffffff15;font-size:9px;letter-spacing:2px;color:#777}
@keyframes fade{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
@keyframes breath{0%,100%{transform:scale(.9);opacity:.65}50%{transform:scale(1.12);opacity:1}}
@media(max-width:700px){nav{padding:22px 5%}.logo{font-size:18px;letter-spacing:4px}.navlinks{gap:13px}.navlinks a{display:none}.hero{padding-top:110px}.core-wrap{width:94vw;height:94vw;max-height:none;margin-bottom:0}h1{letter-spacing:-2px}.sub{font-size:12px}.section{padding:80px 6%}.cards{grid-template-columns:1fr}.card{min-height:180px}.final{padding:85px 20px}footer{padding:24px 6%}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;scroll-behavior:auto!important}}

.planner-section{position:relative;z-index:2;padding:70px 6%;background:#090806;border-block:1px solid #80643b}
.planner-shell{max-width:800px;margin:auto;padding:28px;border:1px solid #80643b;border-radius:18px;background:#0b0b0d}
.planner-shell h2{font-size:clamp(30px,5vw,48px)}
.planner-shell h2 span{color:#e6bd72}
.planner-form{display:grid;grid-template-columns:1fr 1fr;gap:15px}
.planner-field{display:flex;flex-direction:column;gap:8px}
.planner-field label{color:#e6bd72;font-size:11px;letter-spacing:2px}
.planner-field input,.planner-field select,.planner-field textarea{box-sizing:border-box;width:100%;padding:13px;background:#090909;color:white;border:1px solid #51432d;border-radius:8px}
.planner-field textarea{min-height:80px}
.planner-field.full,.planner-form button{grid-column:1/-1}
.planner-form button{padding:15px;border:0;border-radius:30px;background:linear-gradient(90deg,#f2d99e,#c99442);font-weight:bold;cursor:pointer}
#plannerStatus{color:#e6bd72;margin-top:15px}
#plannerResult{display:none;white-space:pre-wrap;line-height:1.7;color:#eee;border:1px solid #51432d;padding:18px;margin-top:15px;overflow-wrap:anywhere}
#plannerResult.show{display:block}
@media(max-width:600px){.planner-form{grid-template-columns:1fr}.planner-field.full,.planner-form button{grid-column:auto}}


/* KRYREX interactive study checklist */
.plan-checklist{display:grid;gap:18px;text-align:left}
.plan-progress{padding:16px;border:1px solid #51432d;border-radius:12px;background:#11100e}
.plan-progress-top{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;color:#e6bd72;font-size:12px;letter-spacing:1px}
.plan-progress-track{height:7px;background:#30291e;border-radius:10px;overflow:hidden;margin-top:12px}
#planProgressFill{height:100%;width:0;background:linear-gradient(90deg,#a77a30,#f6d98b);transition:width .25s}
.plan-task-list{display:grid;gap:10px}
.plan-task{display:flex;align-items:flex-start;gap:12px;padding:13px;border:1px solid #393329;border-radius:10px;background:#11110f;color:#eee;line-height:1.6;cursor:pointer}
.plan-task input{accent-color:#e6bd72;width:18px;height:18px;flex-shrink:0;margin-top:3px}
.plan-task:has(input:checked){opacity:.65}
.plan-task:has(input:checked) span{text-decoration:line-through}
.plan-section-title{color:#e6bd72;font-size:14px;letter-spacing:1px;margin:18px 0 4px}

</style>
